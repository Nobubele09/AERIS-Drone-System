WorldInfo {
  info [
    "AERIS - AI Drone System for Autonomous Emergency Response and Disaster Surveillance."
    "Large South African township-inspired residential environment with houses, local shops, streets and vehicles."
    "Emergency incident markers identify fire, flood and accident locations for simulated drone surveillance."
  ]
  title "AERIS - Kasi Emergency Response Environment"
  basicTimeStep 8
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}
